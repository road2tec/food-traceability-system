# Server
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/food_traceability
# REQUIRED in production (>=32 chars). In development a random secret is generated per boot if unset.
JWT_SECRET=
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5180
PUBLIC_BASE_URL=http://localhost:5180
TRUST_PROXY=0
BCRYPT_ROUNDS=12
UPLOAD_DIR=uploads
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# AI service
AI_SERVICE_URL=http://127.0.0.1:8001
AI_TIMEOUT_MS=8000

# Seed (npm run seed). If unset, random passwords are generated and printed once.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
